void create_ui(lv_obj_t* parent) {
    // brightness_slider: brightness_slider_0 (slider)
    lv_obj_t* brightness_slider_0 = lv_slider_create(parent);

    obj_registry_add("brightness_slider", brightness_slider_0);
    lv_obj_set_style_width(brightness_slider_0, 200, 0);
    lv_obj_center(brightness_slider_0);
    lv_slider_set_value(brightness_slider_0, 80, LV_ANIM_ON);

    // unnamed: label_1 (label)
    lv_obj_t* label_1 = lv_label_create(parent);

    lv_obj_align_to(label_1, brightness_slider_0, LV_ALIGN_OUT_TOP_MID, 0, -15);
    lv_label_set_text(label_1, "Brightness");

}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
}
