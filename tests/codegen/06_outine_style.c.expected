// --- Hoisted Variables (shared between create_ui and deferred functions) ---
static lv_style_t* style_0 = NULL;

void create_ui(lv_obj_t* parent) {
    // style: style_0 (style)
    style_0 = LVGL_UI_MALLOC(sizeof(lv_style_t));
    if (style_0 == NULL) {
        lvgl_ui_handle_oom("style_0");
    }

    lv_style_init(style_0);
    obj_registry_add("style", style_0);
    lv_style_set_radius(style_0, 5);
    lv_style_set_bg_opa(style_0, LV_OPA_COVER);
    lv_style_set_bg_color(style_0, lv_palette_lighten(LV_PALETTE_GREY, 1));
    lv_style_set_outline_width(style_0, 2);
    lv_style_set_outline_color(style_0, lv_palette_main(LV_PALETTE_BLUE));
    lv_style_set_outline_pad(style_0, 8);

    // unnamed: obj_1 (obj)
    lv_obj_t* obj_1 = lv_obj_create(parent);

    lv_obj_add_style(obj_1, style_0, LV_PART_MAIN);
    lv_obj_center(obj_1);

}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
    // Free all hoisted (file-scope) allocations.
    // destroy_* fns already NULL these after their own frees, so free(NULL) is safe.
    LVGL_UI_FREE(style_0); style_0 = NULL;
}
