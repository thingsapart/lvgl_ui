    obj_registry_add("root_obj", root_obj_0);
    // unnamed: label_1 (label)
    lv_obj_t* label_1 = lv_label_create(root_obj_0);

    lv_label_set_text(label_1, "This label should be created");


}

void destroy_ui(lv_obj_t** root_ptr) {
