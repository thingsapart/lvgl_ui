void create_ui(lv_obj_t* parent) {
    // unnamed: obj_0 (obj)
    lv_obj_t* obj_0 = lv_obj_create(parent);

    lv_obj_set_style_width(obj_0, 320, 0);
    lv_obj_set_style_height(obj_0, 240, 0);
