void create_ui(lv_obj_t* parent) {
    // style: style_0 (style)
    lv_style_t* style_0 = LVGL_UI_MALLOC(sizeof(lv_style_t));

    lv_style_init(style_0);
    obj_registry_add("style", style_0);
    lv_style_set_arc_color(style_0, lv_palette_main(LV_PALETTE_RED));
    lv_style_set_arc_width(style_0, 4);

    // unnamed: arc_1 (arc)
    lv_obj_t* arc_1 = lv_arc_create(parent);

    lv_obj_add_style(arc_1, style_0, 0);
    lv_obj_center(arc_1);

}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
}
