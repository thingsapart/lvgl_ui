void create_ui(lv_obj_t* parent) {
    // my_button: my_button_0 (button)
    lv_obj_t* my_button_0 = lv_button_create(parent);

    obj_registry_add("my_button", my_button_0);
    lv_obj_set_style_size(my_button_0, 120, 50, 0);
    lv_obj_center(my_button_0);
    // label_1: label_1_1 (label)
    lv_obj_t* label_1_1 = lv_label_create(my_button_0);

    obj_registry_add("label_1", label_1_1);
    lv_label_set_text(label_1_1, "Click Me");
    lv_obj_center(label_1_1);


}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
}
