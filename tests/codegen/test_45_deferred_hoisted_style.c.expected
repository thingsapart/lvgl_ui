void create_ui(lv_obj_t* parent) {
    // tab_style: tab_style_0 (style)
    tab_style_0 = LVGL_UI_MALLOC(sizeof(lv_style_t));
    if (tab_style_0 == NULL) {
        lvgl_ui_handle_oom("tab_style_0");
    }

    lv_style_init(tab_style_0);
    obj_registry_add("tab_style", tab_style_0);
    lv_style_set_bg_color(tab_style_0, lv_color_hex(0x112233));
    lv_style_set_bg_opa(tab_style_0, LV_OPA_COVER);

    // unnamed: tabview_1 (tabview)
    lv_obj_t* tabview_1 = lv_tabview_create(parent);

    lv_obj_set_style_size(tabview_1, 300, 200, 0);
    lv_obj_center(tabview_1);
    // unnamed: obj_2 (obj)
    lv_obj_t* obj_2 = lv_tabview_add_tab(tabview_1, "Home");

    deferred_loader_register(tabview_1, obj_2, create_home_tab);

    // unnamed: obj_4 (obj)
    lv_obj_t* obj_4 = lv_tabview_add_tab(tabview_1, "Settings");

    deferred_loader_register(tabview_1, obj_4, create_settings_tab);

    deferred_loader_init(tabview_1);

}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
    // Free all hoisted (file-scope) allocations.
    // destroy_* fns already NULL these after their own frees, so free(NULL) is safe.
    LVGL_UI_FREE(tab_style_0); tab_style_0 = NULL;
}
