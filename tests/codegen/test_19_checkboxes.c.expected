    lv_checkbox_set_text(checkbox_2, "Extra Cheese");

    // unnamed: checkbox_3 (checkbox)
    lv_obj_t* checkbox_3 = lv_checkbox_create(obj_0);

    lv_checkbox_set_text(checkbox_3, "Pepperoni");
    lv_obj_add_state(checkbox_3, LV_STATE_CHECKED);

    // unnamed: checkbox_4 (checkbox)
    lv_obj_t* checkbox_4 = lv_checkbox_create(obj_0);

    lv_checkbox_set_text(checkbox_4, "Mushrooms");


}

void destroy_ui(lv_obj_t** root_ptr) {
