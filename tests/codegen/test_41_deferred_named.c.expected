    lv_label_set_text(label_2, "Home Content");
    lv_obj_set_style_align(label_2, LV_ALIGN_CENTER, 0);

}

static void destroy_home_tab(lv_obj_t** obj_ptr) {
    if (!obj_ptr || !*obj_ptr) return;
