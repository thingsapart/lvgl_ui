void create_ui(lv_obj_t* parent) {
    // style_btn: style_btn_0 (style)
    lv_style_t* style_btn_0 = LVGL_UI_MALLOC(sizeof(lv_style_t));

    lv_style_init(style_btn_0);
    obj_registry_add("style_btn", style_btn_0);
    lv_style_set_radius(style_btn_0, 10);
    lv_style_set_bg_opa(style_btn_0, LV_OPA_COVER);
    lv_style_set_bg_color(style_btn_0, lv_palette_lighten(LV_PALETTE_GREY, 2));
    lv_style_set_bg_grad_color(style_btn_0, lv_palette_main(LV_PALETTE_GREY));
    lv_style_set_bg_grad_dir(style_btn_0, LV_GRAD_DIR_VER);
    lv_style_set_border_color(style_btn_0, lv_color_hex(0x000000));
    lv_style_set_border_opa(style_btn_0, LV_OPA_20);
    lv_style_set_border_width(style_btn_0, 2);
    lv_style_set_text_color(style_btn_0, lv_color_hex(0x000000));

    // style_button_red: style_button_red_1 (style)
    lv_style_t* style_button_red_1 = LVGL_UI_MALLOC(sizeof(lv_style_t));

    lv_style_init(style_button_red_1);
    obj_registry_add("style_button_red", style_button_red_1);
    lv_style_set_bg_color(style_button_red_1, lv_palette_main(LV_PALETTE_RED));
    lv_style_set_bg_grad_color(style_button_red_1, lv_palette_lighten(LV_PALETTE_RED, 3));

    // unnamed: button_2 (button)
    lv_obj_t* button_2 = lv_button_create(parent);

    lv_obj_remove_style_all(button_2);
    lv_obj_set_pos(button_2, 10, 10);
    lv_obj_set_style_size(button_2, 120, 50, 0);
    lv_obj_add_style(button_2, style_btn_0, LV_PART_MAIN);
    // unnamed: label_3 (label)
    lv_obj_t* label_3 = lv_label_create(button_2);

    lv_label_set_text(label_3, "Button");
    lv_obj_center(label_3);


    // unnamed: button_4 (button)
    lv_obj_t* button_4 = lv_button_create(parent);

    lv_obj_remove_style_all(button_4);
    lv_obj_set_pos(button_4, 10, 80);
    lv_obj_set_style_size(button_4, 120, 50, 0);
    lv_obj_add_style(button_4, style_btn_0, LV_PART_MAIN);
    lv_obj_add_style(button_4, style_button_red_1, LV_PART_MAIN);
    lv_obj_set_style_radius(button_4, LV_RADIUS_CIRCLE, 0);
    // unnamed: label_5 (label)
    lv_obj_t* label_5 = lv_label_create(button_4);

    lv_label_set_text(label_5, "Button 2");
    lv_obj_center(label_5);


}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
}
