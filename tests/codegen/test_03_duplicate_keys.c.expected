void create_ui(lv_obj_t* parent) {
    // style1: style1_0 (style)
    lv_style_t* style1_0 = LVGL_UI_MALLOC(sizeof(lv_style_t));

    lv_style_init(style1_0);
    obj_registry_add("style1", style1_0);
    lv_style_set_bg_color(style1_0, lv_color_hex(0xFF0000));

    // style2: style2_1 (style)
    lv_style_t* style2_1 = LVGL_UI_MALLOC(sizeof(lv_style_t));

    lv_style_init(style2_1);
    obj_registry_add("style2", style2_1);
    lv_style_set_border_width(style2_1, 2);
    lv_style_set_border_color(style2_1, lv_color_hex(0x0000FF));

    // unnamed: obj_2 (obj)
    lv_obj_t* obj_2 = lv_obj_create(parent);

    lv_obj_set_style_size(obj_2, 100, 50, 0);
    lv_obj_center(obj_2);
    lv_obj_add_style(obj_2, style1_0, 0);
    lv_obj_add_style(obj_2, style2_1, 0);

}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
}
