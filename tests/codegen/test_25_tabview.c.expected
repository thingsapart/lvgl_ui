void create_ui(lv_obj_t* parent) {
    // unnamed: tabview_0 (tabview)
    lv_obj_t* tabview_0 = lv_tabview_create(parent);

    lv_obj_set_style_size(tabview_0, 250, 180, 0);
    lv_obj_center(tabview_0);
    // unnamed: obj_1 (obj)
    lv_obj_t* obj_1 = lv_tabview_add_tab(tabview_0, "Tab 1");

    // unnamed: label_2 (label)
    lv_obj_t* label_2 = lv_label_create(obj_1);

    lv_label_set_text(label_2, "Content of Tab 1");
    lv_obj_center(label_2);


    // unnamed: obj_3 (obj)
    lv_obj_t* obj_3 = lv_tabview_add_tab(tabview_0, "Tab 2");

    // unnamed: slider_4 (slider)
    lv_obj_t* slider_4 = lv_slider_create(obj_3);

    lv_obj_set_style_width(slider_4, 150, 0);
    lv_obj_center(slider_4);


    // unnamed: obj_5 (obj)
    lv_obj_t* obj_5 = lv_tabview_add_tab(tabview_0, "Tab 3");

    // unnamed: switch_6 (switch)
    lv_obj_t* switch_6 = lv_switch_create(obj_5);

    lv_obj_center(switch_6);



}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
}
