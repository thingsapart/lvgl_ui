    lv_obj_set_style_size(button_0, 50, 50, 0);
    // unnamed: label_1 (label)
    lv_obj_t* label_1 = lv_label_create(button_0);

    lv_label_set_text(label_1, "\xef\x81\x8b");
    lv_obj_center(label_1);

    lv_obj_set_pos(button_0, 10, 10);

    // unnamed: button_2 (button)
    lv_obj_t* button_2 = lv_button_create(parent);

    lv_obj_set_style_size(button_2, 50, 50, 0);
    // unnamed: label_3 (label)
