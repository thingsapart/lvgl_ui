void create_ui(lv_obj_t* parent) {
    // unnamed: obj_0 (obj)
    lv_obj_t* obj_0 = lv_obj_create(parent);

    lv_obj_set_style_layout(obj_0, LV_LAYOUT_FLEX, 0);
    lv_obj_set_style_flex_flow(obj_0, LV_FLEX_FLOW_COLUMN, 0);
    lv_obj_set_style_size(obj_0, 240, 300, 0);
    lv_obj_center(obj_0);
    lv_obj_set_style_pad_all(obj_0, 10, 0);
    lv_obj_set_style_pad_gap(obj_0, 10, 0);
    // unnamed: label_1 (label)
    lv_obj_t* label_1 = lv_label_create(obj_0);

    lv_label_set_text(label_1, "Username");

    // unnamed: textarea_2 (textarea)
    lv_obj_t* textarea_2 = lv_textarea_create(obj_0);

    lv_textarea_set_one_line(textarea_2, true);
    lv_textarea_set_placeholder_text(textarea_2, "Enter username...");

    // unnamed: label_3 (label)
    lv_obj_t* label_3 = lv_label_create(obj_0);

    lv_label_set_text(label_3, "Password");

    // unnamed: textarea_4 (textarea)
    lv_obj_t* textarea_4 = lv_textarea_create(obj_0);

    lv_textarea_set_one_line(textarea_4, true);
    lv_textarea_set_password_mode(textarea_4, true);
    lv_textarea_set_placeholder_text(textarea_4, "Enter password...");

    // unnamed: button_5 (button)
    lv_obj_t* button_5 = lv_button_create(obj_0);

    lv_obj_set_style_flex_grow(button_5, 1, 0);
    // unnamed: label_6 (label)
    lv_obj_t* label_6 = lv_label_create(button_5);

    lv_label_set_text(label_6, "Login");
    lv_obj_center(label_6);



}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
}
