// --- Hoisted Variables (shared between create_ui and deferred functions) ---
static lv_style_t* font_large_0 = NULL;

void create_ui(lv_obj_t* parent) {
    // font_large: font_large_0 (style)
    font_large_0 = LVGL_UI_MALLOC(sizeof(lv_style_t));
    if (font_large_0 == NULL) {
        lvgl_ui_handle_oom("font_large_0");
    }

    lv_style_init(font_large_0);
    obj_registry_add("font_large", font_large_0);

    // unnamed: obj_1 (obj)
    lv_obj_t* obj_1 = lv_obj_create(parent);

    lv_obj_set_style_layout(obj_1, LV_LAYOUT_FLEX, 0);
    lv_obj_set_style_flex_flow(obj_1, LV_FLEX_FLOW_COLUMN, 0);
    lv_obj_set_style_size(obj_1, 150, LV_SIZE_CONTENT, 0);
    lv_obj_set_style_pad_all(obj_1, 10, 0);
    lv_obj_set_style_radius(obj_1, 5, 0);
    lv_obj_set_style_bg_color(obj_1, lv_palette_lighten(LV_PALETTE_GREY, 2), 0);
    // unnamed: label_2 (label)
    lv_obj_t* label_2 = lv_label_create(obj_1);

    lv_label_set_text(label_2, "Temperature");

    // unnamed: label_3 (label)
    lv_obj_t* label_3 = lv_label_create(obj_1);

    lv_label_set_text(label_3, "\xef\x8c\x84");
    lv_obj_set_style_text_font(label_3, font_large_0, 0);

    // unnamed: label_4 (label)
    lv_obj_t* label_4 = lv_label_create(obj_1);

    lv_label_set_text(label_4, "23.5 C");

    lv_obj_set_pos(obj_1, 10, 10);

}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
    // Free all hoisted (file-scope) allocations.
    // destroy_* fns already NULL these after their own frees, so free(NULL) is safe.
    LVGL_UI_FREE(font_large_0); font_large_0 = NULL;
}
