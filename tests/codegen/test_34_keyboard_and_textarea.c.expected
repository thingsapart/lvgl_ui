void create_ui(lv_obj_t* parent) {
    // unnamed: obj_0 (obj)
    lv_obj_t* obj_0 = lv_obj_create(parent);

    lv_obj_set_style_layout(obj_0, LV_LAYOUT_FLEX, 0);
    lv_obj_set_style_flex_flow(obj_0, LV_FLEX_FLOW_COLUMN, 0);
    lv_obj_set_style_size(obj_0, 300, 250, 0);
    lv_obj_center(obj_0);
    // ta: ta_1 (textarea)
    lv_obj_t* ta_1 = lv_textarea_create(obj_0);

    obj_registry_add("ta", ta_1);
    lv_obj_set_style_width(ta_1, lv_pct(100), 0);
    lv_textarea_set_one_line(ta_1, false);

    // unnamed: keyboard_2 (keyboard)
    lv_obj_t* keyboard_2 = lv_keyboard_create(obj_0);

    lv_obj_set_style_width(keyboard_2, lv_pct(100), 0);
    lv_obj_set_style_flex_grow(keyboard_2, 1, 0);
    lv_keyboard_set_textarea(keyboard_2, ta_1);


}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
}
