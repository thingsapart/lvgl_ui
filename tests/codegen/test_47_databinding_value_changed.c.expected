void create_ui(lv_obj_t* parent) {
    // file_table: file_table_0 (table)
    lv_obj_t* file_table_0 = lv_table_create(parent);

    obj_registry_add("file_table", file_table_0);
    lv_obj_set_style_size(file_table_0, 200, 120, 0);
    lv_obj_align(file_table_0, LV_ALIGN_TOP_LEFT, 10, 10);
    data_binding_add_action(file_table_0, "File.select", 4, NULL, 0, NULL);

    // brightness_slider: brightness_slider_1 (slider)
    lv_obj_t* brightness_slider_1 = lv_slider_create(parent);

    obj_registry_add("brightness_slider", brightness_slider_1);
    lv_obj_set_style_width(brightness_slider_1, 200, 0);
    lv_obj_align(brightness_slider_1, LV_ALIGN_TOP_LEFT, 10, 150);
    data_binding_add_action(brightness_slider_1, "Settings.brightness", 4, NULL, 0, NULL);

    // speed_arc: speed_arc_2 (arc)
    lv_obj_t* speed_arc_2 = lv_arc_create(parent);

    obj_registry_add("speed_arc", speed_arc_2);
    lv_obj_set_style_size(speed_arc_2, 100, 100, 0);
    lv_obj_align(speed_arc_2, LV_ALIGN_TOP_LEFT, 230, 10);
    data_binding_add_action(speed_arc_2, "Motor.speed", 4, NULL, 0, NULL);

    // mode_dropdown: mode_dropdown_3 (dropdown)
    lv_obj_t* mode_dropdown_3 = lv_dropdown_create(parent);

    obj_registry_add("mode_dropdown", mode_dropdown_3);
    lv_obj_align(mode_dropdown_3, LV_ALIGN_TOP_LEFT, 230, 150);
    lv_dropdown_set_options(mode_dropdown_3, "Mode A\nMode B\nMode C");
    data_binding_add_action(mode_dropdown_3, "Settings.mode", 4, NULL, 0, NULL);

    // axis_roller: axis_roller_4 (roller)
    lv_obj_t* axis_roller_4 = lv_roller_create(parent);

    obj_registry_add("axis_roller", axis_roller_4);
    lv_obj_align(axis_roller_4, LV_ALIGN_TOP_LEFT, 10, 300);
    lv_roller_set_options(axis_roller_4, "X\nY\nZ", LV_ROLLER_MODE_NORMAL);
    data_binding_add_action(axis_roller_4, "Jog.axis", 4, NULL, 0, NULL);

}

void destroy_ui(lv_obj_t** root_ptr) {
    if (!root_ptr || !*root_ptr) return;
    lv_obj_delete(*root_ptr);
    *root_ptr = NULL;
}
