void create_ui(lv_obj_t* parent) {
    // unnamed: led_0 (led)
    lv_obj_t* led_0 = lv_led_create(parent);

    lv_obj_align(led_0, LV_ALIGN_CENTER, -80, 0);
    lv_led_off(led_0);

    // unnamed: led_1 (led)
    lv_obj_t* led_1 = lv_led_create(parent);

    lv_obj_align(led_1, LV_ALIGN_CENTER, 0, 0);
    lv_led_set_brightness(led_1, 150);
    lv_led_set_color(led_1, lv_palette_main(LV_PALETTE_RED));

    // unnamed: led_2 (led)
    lv_obj_t* led_2 = lv_led_create(parent);

    lv_obj_align(led_2, LV_ALIGN_CENTER, 80, 0);
    lv_led_on(led_2);

    // observed_led: observed_led_3 (led)
    lv_obj_t* observed_led_3 = lv_led_create(parent);

    obj_registry_add("observed_led", observed_led_3);
    lv_obj_align(observed_led_3, LV_ALIGN_CENTER, 0, 80);
    data_binding_add_observer("machine.homed", observed_led_3, 5, (const binding_map_entry_t[]){ { .key = { .type=BINDING_TYPE_BOOL, .as.b_val=true }, .value = { .b_val = true } } }, 1, (const void*)&(bool){false});

}

void destroy_ui(lv_obj_t** root_ptr) {
