{
  "name": "lvgl_ui_runtime",
  "version": "1.0.0",
  "description": "Runtime library for UIs generated by lvgl_ui_generator.",
  "keywords": "lvgl, ui, gui, declarative",
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "build": {
    "flags": [
      "-I..",
      "-D LVGL_UI_RUNTIME"
    ],
    "srcFilter": [
      "+<../data_binding.c>",
      "+<../utils.c>",
      "+<../obj_registry.c>",
      "+<../debug_log.c>",
      "+<../lvgl_ui.c>"
    ],
    "libArchive": true
  }
}
