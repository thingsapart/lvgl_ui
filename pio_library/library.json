{
  "name": "lvgl_ui_runtime",
  "version": "1.0.1",
  "description": "Runtime library for UIs generated by lvgl_ui_generator.",
  "keywords": "lvgl, ui, gui, declarative",
  "license": "MIT",
  "frameworks": "*",
  "platforms": "*",
  "dependencies": {
    "lvgl/lvgl": "https://github.com/lvgl/lvgl",
    "DaveGamble/cJSON": "https://github.com/DaveGamble/cJSON.git"
  },
  "build": {
    "flags": [
      "-I..",
      "-D LVGL_UI_RUNTIME"
    ],
    "srcFilter": [
      "+<../api_spec.c>",
      "+<../api_spec.h>",
      "+<../data_binding.c>",
      "+<../data_binding.h>",
      "+<../deferred_loader.h>",
      "+<../deferred_loader.c>",
      "+<../utils.c>",
      "+<../utils.h>",
      "+<../obj_registry.c>",
      "+<../obj_registry.h>",
      "+<../debug_log.c>",
      "+<../lvgl_ui.c>",
      "+<../lvgl_ui.h>"
    ],
    "libArchive": true
  }
}

